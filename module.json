{
  "id": "tinheads-combat-hud",
  "title": "Tinhead's Combat Hud",
  "description": "Nested radial combat HUD for dnd5e. Open from a token to pick Action, Bonus Action, Reaction, or Checks and resolve through the system. Supports socketlib proxy for absent-player control.",
  "version": "0.3.4",
  "compatibility": {
    "minimum": "14.367",
    "verified": "14",
    "maximum": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "6.0.0"
        }
      }
    ],
    "requires": [
      {
        "id": "socketlib",
        "type": "module",
        "compatibility": {}
      }
    ]
  },
  "socket": true,
  "esmodules": [
    "scripts/module.js"
  ],
  "styles": [
    "styles/combat-hud.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "authors": [
    {
      "name": "Tinhead"
    }
  ],
  "url": "https://github.com/Tinhead69/Tinheads-Combat-Hud",
  "manifest": "https://raw.githubusercontent.com/Tinhead69/Tinheads-Combat-Hud/main/module.json",
  "download": "https://github.com/Tinhead69/Tinheads-Combat-Hud/archive/refs/heads/main.zip",
  "license": "MIT",
  "readme": "https://github.com/Tinhead69/Tinheads-Combat-Hud/blob/main/README.md",
  "bugs": "https://github.com/Tinhead69/Tinheads-Combat-Hud/issues",
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "html",
        "hbs",
        "json"
      ],
      "paths": [
        "styles",
        "lang",
        "templates"
      ]
    }
  }
}
